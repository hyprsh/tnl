{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "examples/compose/edge.yaml"
        },
        {
          "type": "generic",
          "path": "examples/compose/outpost.yaml"
        },
        {
          "type": "generic",
          "path": "docs/guide/declaring-the-edge.md"
        },
        {
          "type": "generic",
          "path": "docs/guide/outposts.md"
        }
      ]
    }
  }
}
